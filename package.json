{
  "name": "react-json-to-excel",
  "version": "2.0.0",
  "description": "Download the json as excel",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-lib": "rollup -c && cp src/index.d.ts dist/index.d.ts",
    "prepublishOnly": "npm test && npm run build-lib"
  },
  "author": {
    "name": "yedidi manikanta",
    "email": "maniyedidi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maniyedidi/react-json-to-excel"
  },
  "license": "MIT",
  "peerDependencies": {
    "file-saver": "^2.0.5",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "xlsx": ">=0.18.5"
  },
  "keywords": [
    "react",
    "json",
    "excel",
    "download excel",
    "download json",
    "react json to excel",
    "json to excel "
  ],
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "file-saver": "^2.0.5",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.2",
    "storybook": "^10.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "types": "dist/index.d.ts"
}
